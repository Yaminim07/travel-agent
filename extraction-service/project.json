{
  "name": "extraction-service",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd extraction-service && python3 -m pip install fastapi uvicorn pydantic python-dotenv httpx openai google-generativeai pinecone",
        "cwd": "./"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd extraction-service && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload",
        "cwd": "./"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd extraction-service && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8001",
        "cwd": "./"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd extraction-service && python3 -m compileall app",
        "cwd": "./"
      }
    }
  }
}
